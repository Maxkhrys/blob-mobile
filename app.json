{
  "expo": {
    "name": "CHERRIPI",
    "slug": "blob-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/cherri-icon.png",
    "scheme": "blobmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/cherri-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111110",
        "foregroundImage": "./assets/branding/cherri-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/branding/cherri-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F2F1",
          "image": "./assets/branding/cherri-icon.png",
          "imageWidth": 112
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
